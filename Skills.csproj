<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds against the locally installed game and mod profile instead of NuGet game libs,
    so we always compile against the exact game version we play (1.5.0 at time of writing).
    Override the two paths on the command line if they differ:
      dotnet build -p:GameDir="D:\...\Risk of Rain 2" -p:ProfileDir="C:\...\profiles\Default"
    or put them in a git-ignored Skills.local.props next to this file:
      <Project><PropertyGroup><GameDir>D:\...\Risk of Rain 2</GameDir></PropertyGroup></Project>
  -->
  <Import Project="Skills.local.props" Condition="Exists('Skills.local.props')" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Skills</AssemblyName>
    <RootNamespace>SkillsPlusPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591;IDE0051;CS0618</NoWarn>
    <DebugType>portable</DebugType>
    <Authors>CWMlolzlz, Volvary, icebro, damioGit</Authors>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\com.kesomannen.gale\riskofrain2\profiles\Default</ProfileDir>
    <Managed>$(GameDir)\Risk of Rain 2_Data\Managed</Managed>
    <BepCore>$(ProfileDir)\BepInEx\core</BepCore>
    <Plugins>$(ProfileDir)\BepInEx\plugins</Plugins>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="libs\**;PublicAPITest\**;Tests\**;bin\**;obj\**" />
    <None Remove="libs\**;Tests\**;Images\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game -->
    <Reference Include="$(Managed)\RoR2.dll" Private="false" Publicize="true" />
    <Reference Include="$(Managed)\HGCSharpUtils.dll" Private="false" />
    <Reference Include="$(Managed)\HGUnityUtils.dll" Private="false" />
    <Reference Include="$(Managed)\LegacyResourcesAPI.dll" Private="false" />
    <Reference Include="$(Managed)\Rewired_Core.dll" Private="false" />
    <Reference Include="$(Managed)\Rewired_CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Addressables.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(Managed)\com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\KinematicCharacterController.dll" Private="false" />
    <Reference Include="$(Managed)\AsyncManagement.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine*.dll" Private="false" />

    <!-- BepInEx / MonoMod / Harmony -->
    <Reference Include="$(BepCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepCore)\Mono.Cecil.dll" Private="false" />
    <Reference Include="$(BepCore)\MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(BepCore)\MonoMod.Utils.dll" Private="false" />
    <Reference Include="$(Plugins)\MMHOOK\MMHOOK_RoR2.dll" Private="false" />

    <!-- Mod dependencies -->
    <Reference Include="$(Plugins)\RiskofThunder-R2API_*\**\R2API.*.dll" Exclude="$(Plugins)\**\*.Interop.dll;$(Plugins)\**\R2API.Animations.Editor.dll" Private="false" />
    <Reference Include="$(Plugins)\tristanmcpherson-R2API\R2API.Legacy\R2API.dll" Private="false" />
    <Reference Include="$(Plugins)\Rune580-Risk_Of_Options\RiskOfOptions\RiskOfOptions.dll" Private="false" />
    <Reference Include="$(Plugins)\pseudopulse-Rebindables\Rebindables.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.png;manifest.json;README.md;CHANGELOG.md;Resources\SkillsPlusPlus.language">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
